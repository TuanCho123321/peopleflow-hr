# Copy to .env; never commit real passwords.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
LOCAL_ONLY=false
APP_ORIGIN=http://localhost:3000
# demo = temporary memory data; sqlserver = real SQL Server database.
DATA_MODE=demo
SQL_AUTH=sql
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=PeopleOS
SQL_USER=peopleos_app
SQL_PASSWORD=REPLACE_WITH_LOCAL_SECRET
SQL_ENCRYPT=true
SQL_TRUST_CERT=false
# Optional Windows integrated authentication (requires Windows, msnodesqlv8 and ODBC driver).
# SQL_AUTH=windows
# SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=PeopleFlow;Trusted_Connection=Yes;Encrypt=Yes;TrustServerCertificate=No;
# Set SQL_TRUST_CERT=true only for a local development server using a self-signed certificate.
# Set true behind HTTPS; leave false only for localhost HTTP.
COOKIE_SECURE=false
# Temporary provisioning values; remove after running server/seed.mjs.
# SEED_ADMIN_EMAIL=your-admin@example.com
# SEED_ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
# Production requires all of these: NODE_ENV=production DATA_MODE=sqlserver
# APP_ORIGIN=https://your-hr-domain.example COOKIE_SECURE=true
# SQL_ENCRYPT=true SQL_TRUST_CERT=false
# Local production on this computer only may use LOCAL_ONLY=true, HOST=127.0.0.1,
# APP_ORIGIN=http://127.0.0.1:3000 and COOKIE_SECURE=false. Never bind remotely in this mode.
